# Copy to .env (never commit it) or set these in your host's secret manager.

# Nebius Token Factory - https://tokenfactory.nebius.com
NEBIUS_API_KEY=
# Optional overrides; run scripts/list_models.py to see the IDs your key can use
# TASTEBOUND_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# TASTEBOUND_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b

# Hard cap on cumulative Token Factory spend; can only be lowered below $50
# TASTEBOUND_NEBIUS_BUDGET_USD=50

# Qloo hackathon key - only valid against https://hackathon.api.qloo.com
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com

# Tavily - https://app.tavily.com
TAVILY_API_KEY=

# Nominatim policy: identify your app, ideally with a contact URL or email
# NOMINATIM_USER_AGENT=tastebound/0.2 (+https://github.com/<you>/tastebound)

# --- Optional: app-wide usage limits (can only be lowered below the hard maxima) ---
# TASTEBOUND_NEBIUS_MAX_PER_HOUR=300      TASTEBOUND_NEBIUS_MAX_PER_DAY=1500
# TASTEBOUND_TAVILY_MAX_PER_HOUR=60       TASTEBOUND_TAVILY_MAX_PER_DAY=200   TASTEBOUND_TAVILY_MAX_TOTAL=500
# TASTEBOUND_QLOO_MAX_PER_HOUR=300        TASTEBOUND_QLOO_MAX_PER_DAY=2000

# --- Tendem (see docs/modules/tendem.md) ---
# TENDEM_API_KEY=
# TASTEBOUND_OPERATOR_PASSPHRASE=          # >= 20 chars, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))"
# TASTEBOUND_TENDEM_LIVE=1                 # arming switch for create/approve; leave unset normally
# Hard caps (env can only tighten): TASTEBOUND_TENDEM_MAX_TASK_USD=12  TASTEBOUND_TENDEM_BUDGET_USD=30
# TASTEBOUND_TENDEM_MAX_TASKS=1  TASTEBOUND_TENDEM_MIN_BALANCE=20

# YouCam (Perfect Corp.) v2: only the API key is used. Hard caps: 600 units, balance floor 440
YOUCAM_API_KEY=
# TASTEBOUND_YOUCAM_MAX_UNITS=600        TASTEBOUND_YOUCAM_MIN_BALANCE=440
# TASTEBOUND_YOUCAM_MAX_PER_HOUR=20      TASTEBOUND_YOUCAM_MAX_PER_DAY=60
